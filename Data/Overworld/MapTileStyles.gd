extends RefCounted
class_name MapTileStyles

## Authored semantic map styling (Docs/System Design/Journal/Overworld
## Map.md): tile source/atlas identity -> map color/feature/priority. A style
## describes the map representation, not the source texture; walkability and
## terrain rules are never inferred from these colors (or vice versa).
## Keys are Vector3i(sourceId, atlasX, atlasY); alternatives other than 0 are
## not styled yet (the generator's survey reports any it encounters).
##
## The initial palette is a generated prototype from each tile's ground
## pixels (bottom 24x12 band of the atlas region) with water/track/fence
## terrain tags from the tileset; a deliberate art pass is still pending.
## Regenerate the survey with:
##   godot --headless --path . --script res://Tools/GenerateOverworldMap.gd -- --survey

const FEATURE_GROUND := "ground"
const FEATURE_WATER := "water"
const FEATURE_ROAD := "road"
const FEATURE_MOUNTAIN := "mountain"
const FEATURE_FOREST := "forest"
const FEATURE_STRUCTURE := "structure"

## Conspicuous development fallback for unknown keys.
const UNKNOWN_STYLE := { "color": Color(1, 0, 1), "feature": FEATURE_GROUND, "priority": 0 }

